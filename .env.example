# PostgreSQL Database connection string
# Example: postgres://username:password@localhost:5432/agrorent
DATABASE_URL="postgres://postgres:postgres@localhost:5432/agrorent"

# JWT Authentication Secret & Expiration
JWT_SECRET="your_jwt_secret_key_change_in_production"
JWT_EXPIRES_IN="7d"

# Server Port (defaults to 3000)
PORT=3000

# Environment (development | production | test)
NODE_ENV="development"

# Phase 10: AI Provider & Assistant Configuration
AI_PROVIDER="gemini"
AI_API_KEY=""
AI_MODEL="gemini-3.8-flash"
AI_MAX_TOKENS=1000
AI_RATE_LIMIT=20
AI_RATE_WINDOW=3600
GEMINI_API_KEY=""

# Phase 6: Razorpay & UPI Payment Configuration
# Use Razorpay Test/Sandbox keys during development (e.g., rzp_test_...)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Merchant UPI Virtual Payment Address (VPA) for dynamic QR code generation
# Example: yourbusiness@upi or agrorent@upi
UPI_ID="agrorent@upi"

# Phase 13: Live Weather Integration Configuration
WEATHER_API_KEY=""
WEATHER_PROVIDER="openweathermap"
WEATHER_API_URL=""

# Application Frontend Base URL (for webhooks, redirects, receipts)
FRONTEND_URL="http://localhost:3000"
